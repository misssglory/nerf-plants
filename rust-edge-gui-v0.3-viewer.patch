+fn preview_scale_controls(ui: &mut egui::Ui, label: &str, state: &mut PreviewState) {
+    ui.horizontal(|ui| {
+        ui.strong(label);
+        if ui.small_button("−").clicked() {
+            state.fit_to_window = false;
+            state.zoom = (state.zoom / 1.25).clamp(MIN_SCALE, MAX_SCALE);
+        }
+        if ui.small_button("+").clicked() {
+            state.fit_to_window = false;
+            state.zoom = (state.zoom * 1.25).clamp(MIN_SCALE, MAX_SCALE);
+        }
+        if ui.small_button("Fit").clicked() {
+            state.fit_to_window = true;
+            state.pan = egui::Vec2::ZERO;
+        }
+        if ui.small_button("1:1").clicked() {
+            state.fit_to_window = false;
+            state.zoom = 1.0;
+            state.pan = egui::Vec2::ZERO;
+        }
+        if ui.small_button("Center").clicked() {
+            state.pan = egui::Vec2::ZERO;
+        }
+    });
+
+    let mut slider_zoom = state.zoom;
+    if ui
+        .add(
+            egui::Slider::new(&mut slider_zoom, MIN_SCALE..=MAX_SCALE)
+                .text("Zoom")
+                .logarithmic(true)
+                .fixed_decimals(2),
+        )
+        .changed()
+    {
+        state.fit_to_window = false;
+        state.zoom = slider_zoom;
+    }
+}
+
+fn copy_view_transform(source: &PreviewState, target: &mut PreviewState) {
+    target.zoom = source.zoom;
+    target.pan = source.pan;
+    target.fit_to_window = source.fit_to_window;
+}
+
+fn show_image_viewer(
+    ui: &mut egui::Ui,
+    texture: Option<&egui::TextureHandle>,
+    state: &mut PreviewState,
+) -> bool {
+    let Some(texture) = texture else {
+        ui.centered_and_justified(|ui| ui.label("No image loaded"));
+        return false;
+    };
+
+    ui.horizontal(|ui| {
+        if ui.small_button("−").clicked() {
+            state.fit_to_window = false;
+            state.zoom = (state.zoom / 1.25).clamp(MIN_SCALE, MAX_SCALE);
+        }
+        if ui.small_button("+").clicked() {
+            state.fit_to_window = false;
+            state.zoom = (state.zoom * 1.25).clamp(MIN_SCALE, MAX_SCALE);
+        }
+        if ui.small_button("Fit").clicked() {
+            state.fit_to_window = true;
+            state.pan = egui::Vec2::ZERO;
+        }
+        if ui.small_button("1:1").clicked() {
+            state.fit_to_window = false;
+            state.zoom = 1.0;
+            state.pan = egui::Vec2::ZERO;
+        }
+        if ui.small_button("Center").clicked() {
+            state.pan = egui::Vec2::ZERO;
+        }
+        ui.separator();
+        ui.label(if state.fit_to_window {
+            "Fit"
+        } else {
+            "Manual"
+        });
+    });
+
+    let before_zoom = state.zoom;
+    let before_pan = state.pan;
+    let before_fit = state.fit_to_window;
+
+    let canvas_size = ui.available_size().max(egui::vec2(80.0, 80.0));
+    let (canvas_rect, response) = ui.allocate_exact_size(canvas_size, egui::Sense::drag());
+    let texture_size = texture.size_vec2();
+
+    let fit_zoom = (canvas_rect.width() / texture_size.x)
+        .min(canvas_rect.height() / texture_size.y)
+        .clamp(MIN_SCALE, MAX_SCALE);
+
+    if state.fit_to_window {
+        state.zoom = fit_zoom;
+        state.pan = egui::Vec2::ZERO;
+    }
+
+    if response.dragged() {
+        state.fit_to_window = false;
+        state.pan += response.drag_delta();
+    }
+
+    if response.hovered() {
+        let (zoom_delta, scroll_delta, ctrl) = ui.input(|input| {
+            (
+                input.zoom_delta(),
+                input.smooth_scroll_delta,
+                input.modifiers.ctrl || input.modifiers.command,
+            )
+        });
+
+        // egui's zoom_delta includes touchpad pinch. Ctrl/Command + wheel is
+        // also interpreted as zoom by winit/egui on the major desktop stacks.
+        if (zoom_delta - 1.0).abs() > 0.001 {
+            let pointer = response.hover_pos().unwrap_or(canvas_rect.center());
+            let image_center = canvas_rect.center() + state.pan;
+            let old_zoom = state.zoom;
+            let new_zoom = (old_zoom * zoom_delta).clamp(MIN_SCALE, MAX_SCALE);
+            if (new_zoom - old_zoom).abs() > f32::EPSILON {
+                let relative = pointer - image_center;
+                state.pan -= relative * (new_zoom / old_zoom - 1.0);
+                state.zoom = new_zoom;
+                state.fit_to_window = false;
+            }
+        } else if ctrl && scroll_delta.y.abs() > 0.0 {
+            let factor = (scroll_delta.y * 0.0025).exp();
+            state.zoom = (state.zoom * factor).clamp(MIN_SCALE, MAX_SCALE);
+            state.fit_to_window = false;
+        } else if scroll_delta.length_sq() > 0.0 {
+            // Native-feeling two-finger touchpad pan / wheel pan.
+            state.fit_to_window = false;
+            state.pan += scroll_delta;
+        }
+    }
+
+    let display_size = texture_size * state.zoom;
+    let image_rect = egui::Rect::from_center_size(canvas_rect.center() + state.pan, display_size);
+    let painter = ui.painter().with_clip_rect(canvas_rect);
+    painter.rect_filled(canvas_rect, 0.0, egui::Color32::BLACK);
+    painter.image(
+        texture.id(),
+        image_rect,
+        egui::Rect::from_min_max(egui::Pos2::ZERO, egui::pos2(1.0, 1.0)),
+        egui::Color32::WHITE,
+    );
+
+    if response.hovered() {
+        ui.ctx().set_cursor_icon(egui::CursorIcon::Grab);
+    }
+
+    response.on_hover_text("Drag to pan • two-finger scroll to pan • pinch/Ctrl+wheel to zoom");
+
+    before_zoom != state.zoom || before_pan != state.pan || before_fit != state.fit_to_window
+}
